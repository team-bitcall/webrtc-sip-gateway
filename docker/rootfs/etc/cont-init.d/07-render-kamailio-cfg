#!/command/with-contenv sh
set -eu

# Copy config to writable tmpfs. Container rootfs is read-only.
mkdir -p /run/kamailio
cp /etc/kamailio/kamailio.cfg /run/kamailio/kamailio.cfg
cp /etc/kamailio/tls.cfg /run/kamailio/tls.cfg

CFG="/run/kamailio/kamailio.cfg"

patch_substdef() {
  token="$1"
  value="$2"
  awk -v tok="$token" -v val="$value" '
    $0 ~ "^#!substdef \"!" tok "!" {
      print "#!substdef \"!" tok "!" val "!g\""
      next
    }
    { print }
  ' "$CFG" > "${CFG}.tmp"
  mv "${CFG}.tmp" "$CFG"
}

escape_substdef_value() {
  printf '%s' "$1" | sed -e 's/[!$]/\\&/g'
}

patch_substdef "GATEWAY_DOMAIN" "${DOMAIN:-localhost}"
patch_substdef "SIP_PORT" "${SIP_UPSTREAM_PORT:-5060}"
patch_substdef "SIP_UPSTREAM_TRANSPORT" "${SIP_UPSTREAM_TRANSPORT:-udp}"
patch_substdef "WEBPHONE_ORIGIN" "$(escape_substdef_value "${WEBPHONE_ORIGIN:-*}")"
patch_substdef "INTERNAL_WSS_PORT" "${INTERNAL_WSS_PORT:-8443}"

sed -i 's|/etc/kamailio/tls.cfg|/run/kamailio/tls.cfg|' "$CFG"
# Preserve mounted operator config, upgrading the pre-release include location.
sed -i 's|/etc/kamailio/seat-routing.cfg|/opt/bitcall/seat-routing.cfg|' "$CFG"

case "${SEAT_MODE:-disabled}" in
  disabled) ;;
  local)
    # Compilation is local and private. No backend or network dependency.
    umask 077
    : "${SEAT_DOMAIN:?SEAT_DOMAIN is required for local mode}"
    python3 /opt/bitcall/compile_seat_snapshot.py \
      --input "${SEAT_SNAPSHOT_FILE:-/etc/bitcall/seats.json}" \
      --output /run/kamailio/seat-snapshot.cfg --expected-domain "$SEAT_DOMAIN"
    sed -i '1a #!define WITH_SEAT_MODE' "$CFG"
    ;;
  managed)
    # Start with no seat authority. The durable helper reconciles unexpired
    # accepted state through its private socket once Kamailio is ready.
    umask 077
    python3 /opt/bitcall/seat/provisioning.py --init
    sed -i '1a #!define WITH_SEAT_MODE\n#!define WITH_SEAT_CONTROL' "$CFG"
    ;;
  *) echo 'kamailio-cfg: invalid SEAT_MODE' >&2; exit 1 ;;
esac

echo "kamailio-cfg: rendered with DOMAIN=${DOMAIN:-localhost}"
