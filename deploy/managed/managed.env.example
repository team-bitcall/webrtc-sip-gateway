# Copy outside this repository; values below are placeholders only.
SEAT_DOMAIN=seats.example.invalid
SEAT_CONTROL_TOKEN=REPLACE_IN_PRIVATE_FILE
# Safe defaults: explicitly enable only after callback, durable paths, and
# recording prerequisites have separately passed their acceptance checks.
SEAT_CALL_EVENTS=0
SEAT_MANAGED_ADMISSION_ENABLED=0
SEAT_RECORDING_ENABLED=0
SEAT_MEDIA_ENABLED=0
# When managed admission is enabled, set both supported fields privately:
# SEAT_MANAGED_ADMISSION_ENDPOINT=https://actual-backend-host/path
# SEAT_MANAGED_ADMISSION_SECRET=43_TO_256_CHAR_BASE64URL_SECRET
# When recording is enabled, all are required:
# SEAT_RECORDING_GATEWAY_ID=https://actual-gateway-origin
# SEAT_RECORDING_CAPTURE_MODE=subscription
# SEAT_RECORDING_SPOOL_DIR=/var/lib/bitcall/recording-spool
# SEAT_RECORDING_OUTPUT_DIR=/var/lib/bitcall/recording-output
# Leave both retention values absent to keep retention disabled.
