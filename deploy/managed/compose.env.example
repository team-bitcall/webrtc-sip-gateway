# Copy outside Git and replace every host path. This file contains no SEAT secrets.
BITCALL_GATEWAY_IMAGE=registry.example.invalid/bitcall-gateway@sha256:REPLACE_64_HEX_DIGEST
GATEWAY_ENV_FILE=/private/bitcall/gateway.env
MANAGED_ENV_FILE=/private/bitcall/managed-gateway.env
SEAT_STATE_HOST_DIR=/srv/bitcall/seat-state
RECORDING_SPOOL_HOST_DIR=/srv/bitcall/recording-spool
RECORDING_OUTPUT_HOST_DIR=/srv/bitcall/recording-output
TLS_CERT=/private/tls/fullchain.pem
TLS_KEY=/private/tls/privkey.pem
KAMAILIO_CONFIG=/private/bitcall/kamailio.cfg
ACME_WEBROOT=/srv/bitcall/acme-webroot
